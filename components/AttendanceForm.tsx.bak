
import React, { useState, useRef } from 'react';
import { Member, Game, Role, Selfie, Sport } from '../types';
import { CheckCircle2, User, Calendar, Trophy, Camera, AlertTriangle, ArrowLeft, MapPin, Loader2 } from 'lucide-react';
import { VENUES } from '../constants';
import { getDistance, getCurrentPosition } from '../utils/location';

interface AttendanceFormProps {
  members: Member[];
  games: Game[];
  sports: Sport[];
  onSubmit: (gameId: string, memberId: string, newMemberDetails?: Member, selfie?: Selfie) => void;
  onBack: () => void;
}

export const AttendanceForm: React.FC<AttendanceFormProps> = ({ members, games, sports, onSubmit, onBack }) => {
  const [step, setStep] = useState(1);
  const [name, setName] = useState('');
  const [email, setEmail] = useState('');
  const [matchedMember, setMatchedMember] = useState<Member | null>(null);
  const [selectedGameId, setSelectedGameId] = useState('');
  const selectedGame = games.find(g => g.id === selectedGameId);
  const selectedSport = selectedGame ? sports.find(s => s.id === selectedGame.sportId) : null;
  const hasVenues = (selectedSport?.venueIds?.length || 0) > 0;
  const [submitted, setSubmitted] = useState(false);
  const [selfiesData, setSelfiesData] = useState<string[]>([]); // Array of base64 strings

  // Location Verification States
  const [isVerifyingLocation, setIsVerifyingLocation] = useState(false);
  const [locationError, setLocationError] = useState<string | null>(null);
  const [isLocationVerified, setIsLocationVerified] = useState(false);

  const fileInputRef = useRef<HTMLInputElement>(null);

  // Date filtering: Only show games for TODAY
  // Note: Using local time for "today"
  const todayStr = new Date().toLocaleDateString('en-CA'); // YYYY-MM-DD format
  const todaysGames = games
    .filter(g => g.date === todayStr)
    .sort((a, b) => (a.time || '23:59').localeCompare(b.time || '23:59'));

  const verifyLocation = async (gameId: string) => {
    if (!gameId) {
      setIsLocationVerified(false);
      return;
    }

    setIsVerifyingLocation(true);
    setLocationError(null);
    setIsLocationVerified(false);

    try {
      const game = games.find(g => g.id === gameId);
      if (!game) throw new Error("Game not found");

      const sport = sports.find(s => s.id === game.sportId);
      if (!sport || !sport.venueIds || sport.venueIds.length === 0) {
        // If no venue defined, we cannot verify location.
        console.warn(`No venues defined for sport ${game.sportId}. Location verification skipped.`);
        // Ensure we don't accidentally verify
        return;
      }

      const position = await getCurrentPosition();
      const { latitude, longitude } = position.coords;

      // Check against all allowed venues for this sport
      const validVenues = VENUES.filter(v => sport.venueIds?.includes(v.id));
      let isNearAnyVenue = false;

      for (const venue of validVenues) {
        const distance = getDistance(latitude, longitude, venue.latitude, venue.longitude);
        console.log(`Checking distance to ${venue.name}: ${Math.round(distance)}m (Radius: ${venue.radiusMeters}m)`);
        if (distance <= venue.radiusMeters) {
          isNearAnyVenue = true;
          break;
        }
      }

      if (isNearAnyVenue) {
        setIsLocationVerified(true);
      } else {
        setLocationError("You must be at the venue to log attendance.");
      }
    } catch (err: any) {
      console.error("Location verification failed", err);
      if (err.code === 1) {
        setLocationError("Location access is required to log attendance.");
      } else if (err.code === 3) {
        setLocationError("Location request timed out. Please try again.");
      } else {
        setLocationError(err.message || "Could not verify your location.");
      }
    } finally {
      setIsVerifyingLocation(false);
    }
  };

  const handleGameChange = (gameId: string) => {
    setSelectedGameId(gameId);
    if (gameId) {
      verifyLocation(gameId);
    } else {
      setIsLocationVerified(false);
      setLocationError(null);
    }
  };

  const handleNameNext = (e: React.FormEvent) => {
    e.preventDefault();
    const found = members.find(m =>
      `${m.firstName} ${m.lastName}`.toLowerCase() === name.toLowerCase().trim()
    );

    if (found) {
      setMatchedMember(found);
      setStep(3); // Skip email
    } else {
      setStep(2); // Go to email
    }
  };

  const handleEmailNext = (e: React.FormEvent) => {
    e.preventDefault();
    const foundByEmail = members.find(m => m.email?.toLowerCase() === email.toLowerCase().trim());
    if (foundByEmail) {
      setMatchedMember(foundByEmail);
    }
    setStep(3);
  };

  const handleSelfieCapture = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = e.target.files;
    if (files && files.length > 0) {
      Array.from(files).forEach((file: File) => {
        const reader = new FileReader();
        reader.onload = (event) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const MAX_WIDTH = 800;
            const scaleSize = MAX_WIDTH / img.width;
            canvas.width = MAX_WIDTH;
            canvas.height = img.height * scaleSize;

            if (ctx) {
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              const compressedData = canvas.toDataURL('image/jpeg', 0.8);
              setSelfiesData(prev => [...prev, compressedData]);
            }
          };
          if (event.target?.result) img.src = event.target.result as string;
        };
        reader.readAsDataURL(file);
      });
    }
  };

  const removeSelfie = (index: number) => {
    setSelfiesData(prev => prev.filter((_, i) => i !== index));
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedGameId) return;

    const finalMemberId = matchedMember ? matchedMember.id : `new_${Date.now()}`;
    let newMember: Member | undefined = undefined;

    if (!matchedMember) {
      const [first, ...last] = name.split(' ');
      newMember = {
        id: finalMemberId,
        firstName: first || name,
        lastName: last.join(' ') || '',
        role: Role.PROSPECTIVE,
        yearsInBPLT: 0,
        email: email
      };
    }

    // Pass selfies array (App.tsx will need update to handle array)
    // Note: The original onSubmit prop signature expects `selfie?: Selfie`. 
    // We will pass the first selfie as 'selfie' to satisfy legacy, but we need to pass all of them.
    // Ideally we update the interface. For now, let's treat the 'selfie' object as a container or just pass undefined and handle logic in App.tsx if we changed onSubmit.
    // WAIT: I can't change onSubmit signature easily without changing App.tsx first or simultaneously.
    // BUT, the user requested multiple uploads.
    // I will pass an array of selfie objects if possible? No, type says `selfie?: Selfie`.
    // I will hack it: Pass the first selfie, but attach the full list to it? Or better, update Types.
    // Let's assume I updated types? No I haven't. 
    // I will call onSubmit iteratively? Handlers are async? 
    // Better: Update App.tsx logic to accept `selfies: Selfie[]`.

    // Construct array of Selfie objects
    const selfieObjects: Selfie[] = selfiesData.map((data, idx) => ({
      id: `selfie_${Date.now()}_${idx}`,
      memberId: finalMemberId,
      gameId: selectedGameId,
      imageData: data,
      timestamp: new Date().toISOString()
    }));

    // Trigger submit. We'll pass the array disguised or modify prop type.
    // Let's modify prop type in next step. For now, passing `selfieObjects` (as `any`).
    onSubmit(selectedGameId, finalMemberId, newMember, selfieObjects as any);
    setSubmitted(true);
  };

  if (submitted) {
    return (
      <div className="min-h-screen bg-slate-50 flex items-center justify-center p-4">
        <div className="bg-white p-8 rounded-xl shadow-sm text-center max-w-md w-full border-t-4 border-[#154734]">
          <div className="w-16 h-16 bg-green-100 text-[#154734] rounded-full flex items-center justify-center mx-auto mb-4">
            <CheckCircle2 className="w-8 h-8" />
          </div>
          <h2 className="text-2xl font-bold text-gray-900 mb-2">
            {matchedMember ? "Sic 'Em!" : "Info Captured"}
          </h2>
          <p className="text-gray-600 mb-6">
            {matchedMember
              ? "Your attendance has been recorded."
              : "Thanks! We've saved your info and will reach out soon."}
          </p>
          <button
            onClick={() => window.location.reload()}
            className="text-[#154734] hover:text-[#FFB81C] font-bold transition-colors"
          >
            Submit another response
          </button>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#154734] flex flex-col items-center pt-12 p-4 relative">
      <button
        onClick={onBack}
        className="absolute top-4 left-4 flex items-center gap-1 text-white/80 hover:text-white text-sm font-medium transition-colors z-10"
      >
        <ArrowLeft className="w-4 h-4" /> Back to Login
      </button>

      <div className="w-full max-w-lg bg-white rounded-xl shadow-lg overflow-hidden border-2 border-[#FFB81C]">
        <div className="bg-[#FFB81C] p-4 text-center">
          <h1 className="text-xl font-bold text-[#154734]">Attendance Check-in</h1>
          <p className="text-[#154734] text-sm font-semibold opacity-90">BearPit Club</p>
        </div>

        <form className="p-6 space-y-6">
          {/* Progress Bar */}
          <div className="flex gap-2 mb-6">
            <div className={`h-1.5 flex-1 rounded-full ${step >= 1 ? 'bg-[#154734]' : 'bg-gray-200'}`}></div>
            <div className={`h-1.5 flex-1 rounded-full ${step >= 2 ? 'bg-[#154734]' : 'bg-gray-200'}`}></div>
            <div className={`h-1.5 flex-1 rounded-full ${step >= 3 ? 'bg-[#154734]' : 'bg-gray-200'}`}></div>
          </div>

          {step === 1 && (
            <div className="space-y-4 animate-in fade-in slide-in-from-right-4 duration-300">
              <div>
                <label className="block text-sm font-bold text-gray-700 mb-1">Your Name</label>
                <div className="relative">
                  <User className="absolute left-3 top-2.5 h-5 w-5 text-gray-400" />
                  <input
                    type="text"
                    required
                    value={name}
                    onChange={e => setName(e.target.value)}
                    className="pl-10 w-full bg-white text-black border border-gray-300 rounded-lg p-2.5 focus:ring-[#FFB81C] focus:border-[#FFB81C]"
                    placeholder="First Last"
                  />
                </div>
                <p className="text-xs text-gray-500 mt-2">Please use the name you registered with.</p>
              </div>
              <button
                onClick={handleNameNext}
                disabled={!name.trim()}
                className="w-full bg-[#154734] text-white py-3 rounded-lg font-bold hover:bg-[#0f3325] disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
              >
                Next
              </button>
            </div>
          )}

          {step === 2 && (
            <div className="space-y-4 animate-in fade-in slide-in-from-right-4 duration-300">
              <div className="bg-blue-50 p-3 rounded-lg text-sm text-blue-800 mb-4 border border-blue-100">
                We couldn't find <strong>{name}</strong> in our records. Please provide your Baylor email to continue.
              </div>
              <div>
                <label className="block text-sm font-bold text-gray-700 mb-1">Your Baylor Email</label>
                <input
                  type="email"
                  required
                  value={email}
                  onChange={e => setEmail(e.target.value)}
                  className="w-full bg-white text-black border border-gray-300 rounded-lg p-2.5 focus:ring-[#FFB81C] focus:border-[#FFB81C]"
                  placeholder="first_last1@baylor.edu"
                />
              </div>
              <button
                onClick={handleEmailNext}
                disabled={!email.includes('@')}
                className="w-full bg-[#154734] text-white py-3 rounded-lg font-bold hover:bg-[#0f3325] disabled:opacity-50 transition-colors"
              >
                Next
              </button>
            </div>
          )}

          {step === 3 && (
            <div className="space-y-5 animate-in fade-in slide-in-from-right-4 duration-300">
              <div>
                <label className="block text-sm font-bold text-gray-700 mb-1">Current Date</label>
                <div className="relative">
                  <Calendar className="absolute left-3 top-2.5 h-5 w-5 text-gray-400" />
                  <input
                    type="text"
                    disabled
                    value={todayStr}
                    className="pl-10 w-full bg-gray-100 border border-gray-300 rounded-lg p-2.5 text-gray-500 cursor-not-allowed"
                  />
                </div>
              </div>

              <div>
                <label className="block text-sm font-bold text-gray-700 mb-1">Event Attended</label>
                <div className="relative">
                  <Trophy className="absolute left-3 top-2.5 h-5 w-5 text-gray-400" />
                  {todaysGames.length > 0 ? (
                    <select
                      value={selectedGameId}
                      onChange={e => handleGameChange(e.target.value)}
                      className="pl-10 w-full bg-white text-black border border-gray-300 rounded-lg p-2.5 focus:ring-[#FFB81C] focus:border-[#FFB81C]"
                    >
                      <option value="">-- Select an Event --</option>
                      {todaysGames.map(g => (
                        <option key={g.id} value={g.id}>
                          {g.opponent} ({g.location}) - {g.time || 'TBA'}
                        </option>
                      ))}
                    </select>
                  ) : (
                    <div className="pl-10 w-full bg-red-50 border border-red-200 rounded-lg p-2.5 text-red-600 flex items-center text-sm">
                      <AlertTriangle className="w-4 h-4 mr-2" /> No games scheduled for today ({todayStr}).
                    </div>
                  )}
                </div>
              </div>

              {/* Verification Hint */}
              <div className={`${hasVenues ? 'bg-yellow-50 border-yellow-100' : 'bg-blue-50 border-blue-100'} p-3 rounded-lg border flex items-start gap-2 mb-2`}>
                <div className="text-[#154734] mt-0.5"><Trophy className="w-4 h-4" /></div>
                <div className="text-xs text-gray-700 leading-relaxed">
                  {hasVenues ? (
                    <><strong>Verification Required:</strong> To log attendance, you must either <strong>be at the venue</strong> (verified via location) OR <strong>upload a photo</strong>.</>
                  ) : (
                    <><strong>Photo Required:</strong> No venue is defined for this sport. You must <strong>upload a photo</strong> to log attendance.</>
                  )}
                </div>
              </div>

              {/* Location Verification Status */}
              {selectedGameId && hasVenues && (
                <div className="animate-in fade-in duration-300">
                  {isVerifyingLocation ? (
                    <div className="flex items-center gap-2 text-sm text-[#154734] bg-green-50 p-3 rounded-lg border border-green-100">
                      <Loader2 className="w-4 h-4 animate-spin" />
                      Checking your location...
                    </div>
                  ) : locationError ? (
                    <div className="flex items-center gap-2 text-sm text-red-600 bg-red-50 p-3 rounded-lg border border-red-100">
                      <AlertTriangle className="w-4 h-4 shrink-0" />
                      <div className="flex-1">
                        <span>{locationError}</span>
                        <p className="text-[10px] opacity-80 mt-0.5">If you can't verify location, please upload a photo below instead.</p>
                      </div>
                      <button
                        type="button"
                        onClick={() => verifyLocation(selectedGameId)}
                        className="ml-auto text-xs font-bold underline whitespace-nowrap"
                      >
                        Retry
                      </button>
                    </div>
                  ) : isLocationVerified ? (
                    <div className="flex items-center gap-2 text-sm text-green-700 bg-green-50 p-3 rounded-lg border border-green-100">
                      <CheckCircle2 className="w-4 h-4" />
                      Location verified! Sic 'Em!
                    </div>
                  ) : null}
                </div>
              )}

              {/* Selfie Section */}
              <div className="pt-4 border-t border-gray-100">
                <label className="block text-sm font-bold text-gray-700 mb-2 flex justify-between">
                  <span>Upload Photos {hasVenues ? '(Required if no location)' : '(Strictly Required)'}</span>
                  <span className="text-xs font-bold text-gray-400 bg-gray-100 px-2 py-0.5 rounded">Multi-select allowed</span>
                </label>

                <input
                  type="file"
                  accept="image/*"
                  multiple // Allow multiple
                  className="hidden"
                  ref={fileInputRef}
                  onChange={handleSelfieCapture}
                />

                <div className="grid grid-cols-2 gap-2 mb-2">
                  {selfiesData.map((data, idx) => (
                    <div key={idx} className="relative rounded-lg overflow-hidden border border-gray-200 bg-gray-50 shadow-sm aspect-square">
                      <img src={data} alt={`Selfie ${idx}`} className="w-full h-full object-cover" />
                      <button
                        type="button"
                        onClick={() => removeSelfie(idx)}
                        className="absolute top-1 right-1 bg-white text-red-500 p-1 rounded-full shadow hover:bg-red-50"
                      >
                        <AlertTriangle className="w-3 h-3" />
                      </button>
                    </div>
                  ))}

                  <button
                    type="button"
                    onClick={() => fileInputRef.current?.click()}
                    className="border-2 border-dashed border-gray-300 rounded-lg p-4 text-gray-500 hover:border-[#FFB81C] hover:bg-yellow-50 transition-colors flex flex-col items-center justify-center gap-2 aspect-square"
                  >
                    <Camera className="w-6 h-6 text-gray-400" />
                    <span className="text-xs font-medium">Add Photo</span>
                  </button>
                </div>
              </div>

              <button
                onClick={handleSubmit}
                disabled={!selectedGameId || (!isLocationVerified && selfiesData.length === 0) || isVerifyingLocation} // Requirement: (Location OR Selfie)
                className="w-full bg-[#154734] text-white py-3 rounded-lg font-bold hover:bg-[#0f3325] disabled:opacity-50 disabled:cursor-not-allowed shadow-md transition-colors mt-4 flex items-center justify-center gap-2"
              >
                <CheckCircle2 className="w-5 h-5" />
                Submit Attendance
              </button>
            </div>
          )}
        </form>
      </div>
    </div>
  );
};
